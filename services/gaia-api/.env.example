# Copy to .env (gitignored) and fill in. Never commit real values.

# ---- VPS setup checklist (new integration wiring) -------------------------
# Everything below runs from one checkout at /root/gaia. When rolling this
# release onto the VPS, these are the values that must exist in THIS .env
# (gaia-api's), or the named feature silently degrades:
#
#   COGNITION_URL          http://gaia-cognition:8890   (container name)
#   COGNITION_BANK_ID      gaia
#   FOUNDATION_URL         http://100.65.0.15:4577       (Tailscale)
#   FOUNDATION_API_TOKEN   <Foundation bearer token>
#
# gaia-api joins the cognition stack's external network via docker-compose
# (cognition_net → cognition_gaia_cognition_default), so COGNITION_URL must be the
# container name, NOT the Tailscale IP. services/cognition/.env needs only
# DATABASE_URL + PORT (already set there). The deploy workflow brings the
# cognition stack up first, so its network exists before gaia-api joins it.
# If COGNITION_URL/FOUNDATION_URL are unset, turns still work — hypotheses,
# the review surface and archive reads simply stay empty.
# ---------------------------------------------------------------------------

# ---- Recommended cheap models per role (EdenAI) ----------------------------
# Documentation only — these are NOT active defaults. The live choice is made
# in /admin (provider store); the GAIA_NATIVE_*/REASONIQ_*/KAIROS_*/AION_* vars
# below are only a fallback. Every role except Voice can also carry its OWN
# provider in /admin (Use Main Provider / OpenAI / EdenAI / Mistral / Custom),
# so reasoning and vision need not share the Main Provider. To use EdenAI, pick
# provider "EdenAI" with baseUrl https://api.edenai.run/v3 — its public catalog
# is exactly what "Retrieve models" reads (GET /v3/models), so every id below
# appears in the dropdown. Verified against that catalog, Oct 2026; USD per 1M
# tokens in/out. Prefer the bare id — the @eu/@us (Azure/Bedrock/Vertex)
# regional variants are ~10% pricier.
#
#   generation  anthropic/claude-haiku-5-5                                0.10/0.50
#               google/gemini-3.1-flash-lite                              0.25/1.50
#   reasoning   deepinfra/deepseek-ai/DeepSeek-V4-Flash                   0.09/0.18
#               deepinfra/deepseek-ai/DeepSeek-V3.2                       0.26/0.38
#   vision      deepinfra/mistralai/Mistral-Small-3.2-24B-Instruct-2506   0.075/0.20
#               google/gemini-3.1-flash-lite                              0.25/1.50
#   kairos      google/gemini-2.5-flash-lite                              0.10/0.40
#               anthropic/claude-haiku-5-5                                0.10/0.50
#   aion        mistral/ministral-3b-2512                                 0.10/0.10
#               openai/gpt-5-nano                                         0.05/0.40
#   eleos       openai/gpt-5-nano                                          0.05/0.40
#   intent      openai/gpt-5-nano                                         0.05/0.40
#   backup      deepinfra/deepseek-ai/DeepSeek-V4-Flash (other host than primary)
#
# Caveats: generation must support tool calling (memoryTool's remember/keep);
# vision must be multimodal. vision AND aion AND eleos FALL BACK to the reasoning
# role when unset (resolveRoleConfig), so a text-only reasoning model silently
# breaks OCR — set vision explicitly. google/gemini-3.1-flash-lite-image has
# NO tool calling; use the bare google/gemini-3.1-flash-lite.
# ---------------------------------------------------------------------------

# Required. Comma-separated bearer tokens clients may use (one per
# client/device is the intended pattern). No token configured = the API
# refuses every request (fail closed).
GAIA_API_TOKEN=change-me

# Where hermes-agent's OpenAI-compatible API is reachable from this
# container. hermes-agent binds only to its own docker network; this
# container joins that network (see docker-compose.yml) and reaches it
# by name, exactly like gaia-hermes-proxy does.
HERMES_BASE_URL=http://hermes:8642/v1

# Model name hermes-agent expects. Provider detail — never returned to any
# client.
HERMES_MODEL=hermes-agent

# The token hermes-agent itself requires (injected here so clients never
# hold it — same pattern as gaia-hermes-proxy).
HERMES_AUTH_TOKEN=

# Research reach — Gaia handing a research-with-sources turn to the Hermes
# `grounded-citations` skill. A research turn SUBMITS a run at Hermes and
# answers straight away; the findings are polled up later, written into the
# conversation, and announced through GET /research/jobs. OFF by default,
# because it means Hermes works unattended on Gaia's behalf with its full
# toolset, including a terminal. Set to `on` to enable.
GAIA_RESEARCH_REACH=

# How often a finished run is looked for, in ms. A grounded-citations run is an
# agent loop — measured live 2026-10-11 it was still going after 15 minutes and
# 33 tool calls — so 20s is a coarse but cheap cadence.
GAIA_RESEARCH_POLL_MS=20000

# Where Gaia reads what a research run left behind. This must be the SAME host
# directory that is mounted into the Hermes container as /shared/out, mounted
# here as e.g. /shared/research-out (see docker-compose.yml). Without the
# shared mount the findings still arrive — only a document would be lost.
GAIA_RESEARCH_OUTBOX=/shared/research-out

# The hard cap on one investigation, in ms. A grounded-citations run is an
# agent loop, so at the cap Gaia stops waiting for depth and takes what Hermes
# has right now, closing the job as done with an honest "afgekapt" message.
# The run is not cancelled — the Hermes API has no cancel — it is simply no
# longer waited on. An explicit 0 turns the cap off; empty means the default.
GAIA_RESEARCH_DEADLINE_MS=600000

# How often Gaia says, in the conversation itself, that the investigation is
# still running. A long run must not be silent, and a check-in promises
# nothing: it only says it is still going.
GAIA_RESEARCH_CHECKIN_MS=180000

# Shallow web search — the OTHER thing, deliberately not research. Gaia can
# look something up on the live web inside the turn itself: one HTTP call, a
# handful of results with their URLs, seconds. No agent, no job, no outbox.
# She may open it on her own when she needs a current fact she cannot know or
# verify (a price, a date, a version, whether something still exists), and it
# is bounded like the memory verbs: one search per call, the result is
# material to read, never her answer.
#
# NO KEY MEANS NO TOOL: without a key there is no provider, so the tool is
# never offered and Gaia does not claim the capability at all (the same
# honesty rule the memory tool follows). The default provider is Brave
# Search (GET /res/v1/web/search with an X-Subscription-Token header); point
# GAIA_WEB_SEARCH_BASE_URL at another provider that speaks the same shape
# ({ web: { results: [{ title, url, description }] } }, or a plain
# { results: [...] }) if you ever want a different one.
GAIA_WEB_SEARCH_API_KEY=
GAIA_WEB_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search

# How many results one lookup may return, and how long it may take. The
# timeout is short on purpose: this runs inside a live turn, so a slow
# provider is reported as a failure rather than stalling the answer.
GAIA_WEB_SEARCH_RESULT_COUNT=5
GAIA_WEB_SEARCH_TIMEOUT_MS=8000

# Where Hindsight is reachable, and the banks Gaia uses. Optional; the URL
# defaults to the Tailscale address.
#
# `bojan` is the system-memory bank: the memoryworthiness-gated conversation
# reflection (what the system judges worth remembering) still writes here,
# unchanged — the gate lives in turn.js.
# `gaia` is Gaia's OWN bank — her memories, her human side. Hers alone, no
# gate; reserved for her own curation (the write path is not built yet, so
# today it is a recall-only source).
# `gaia-logos` holds the derived knowledge Logos forms and Cognition owns —
# hypotheses, patterns, Kairos episodes, mirrored under the gaia:* namespace.
# Per-turn recall spans the whole set (createCrossBankRecallClient in
# hindsightClient.js).
HINDSIGHT_URL=
HINDSIGHT_BANK_ID=bojan
HINDSIGHT_OWN_BANK_ID=gaia
HINDSIGHT_LOGOS_BANK_ID=gaia-logos
# Comma-separated recall set. Optional; defaults to the three banks above.
HINDSIGHT_RECALL_BANK_IDS=

# Aion — Gaia's own-bank write path (src/reasoning/aion.js). A
# background pass asks Gaia whether anything from the conversation is hers to
# keep; what she answers goes to the `gaia` bank, UNGATED, tagged gaia:aion.
# The Memoryworthiness gate governs `bojan`, not her bank. It uses the
# `aion` provider role (pickable in the admin panel; env fallback:
# AION_MODEL_* then the reasoning role). Set GAIA_AION=false to
# switch it off.
GAIA_AION=
# How often the pass runs: once every N turns, plus a flush when the
# conversation changes or goes idle. Defaults: every 5 turns, 5 minutes.
GAIA_AION_EVERY_TURNS=5
GAIA_AION_IDLE_MS=300000
# Optional dedicated model for the Aion pass (else it borrows the
# reasoning role). Same shape as REASONIQ_MODEL_*.
AION_MODEL_BASE_URL=
AION_MODEL_NAME=
AION_MODEL_API_KEY=
AION_MODEL_PROVIDER=
# EdenAI alt: mistral/ministral-3b-2512 | openai/gpt-5-nano (see top block)

# Eleos — the check-in faculty (src/reasoning/eleos.js + src/eleosRuntime.js).
# After a turn it notices a moment worth coming back to (someone said they were
# having a hard time) and — about a day later, outside the conversation —
# starts a NEW conversation to ask how they are doing. The detection half uses
# the `eleos` provider role (pickable in /admin; env fallback: ELEOS_MODEL_*
# then the reasoning role). OFF by default, because it means Gaia speaks first,
# unprompted. Set GAIA_ELEOS=true to enable.
GAIA_ELEOS=
# How much later she comes back. Default 20-28h (a human gap, not a cron); a
# moment tied to a specific upcoming thing may pick a delay in between. The
# model's proposal is clamped to these bounds.
GAIA_ELEOS_DELAY_MIN_MS=72000000
GAIA_ELEOS_DELAY_MAX_MS=100800000
# "Never noisy": at most this many check-ins per rolling 24h, and a recent
# turn (within GAIA_ELEOS_ACTIVE_MS) defers delivery so she never interrupts.
GAIA_ELEOS_MAX_PER_DAY=1
GAIA_ELEOS_ACTIVE_MS=300000
# Quiet hours (local to GAIA_ELEOS_TIMEZONE) — inside them delivery waits,
# UNLESS the person is themselves active at that hour (the explicit exception:
# if you are up at night, she may come back then).
GAIA_ELEOS_QUIET_START=22
GAIA_ELEOS_QUIET_END=8
GAIA_ELEOS_TIMEZONE=Europe/Amsterdam
# Background tick cadence, and how long a deferred loop waits before it is
# reconsidered.
GAIA_ELEOS_TICK_MS=60000
GAIA_ELEOS_DEFER_MS=1800000
# Where open loops are persisted. Optional; defaults to ./data/eleos-intents in
# dev, /app/data/eleos-intents in a container (same data/ volume as the rest).
GAIA_ELEOS_INTENTS_PATH=
# Optional dedicated model for the detection half (else it borrows the
# reasoning role). Same shape as REASONIQ_MODEL_*.
ELEOS_MODEL_BASE_URL=
ELEOS_MODEL_NAME=
ELEOS_MODEL_API_KEY=
ELEOS_MODEL_PROVIDER=
# EdenAI alt: openai/gpt-5-nano (see top block)

# On-demand memory — the tools Gaia may call during a turn
# (src/reasoning/memoryTool.js). `remember` writes to the shared system-memory
# bank (`bojan`); `keep` writes to HER own bank (`gaia` — the same store Aion
# keeps in the background); `search_memory` reads back ungated through the
# cross-bank recall client. Needs the generation model to support tools; if
# the provider rejects them, the turn falls back to plain generation. Off with
# GAIA_MEMORY_TOOL=false.
GAIA_MEMORY_TOOL=

# Recall budget for hindsightClient.js — 'low' | 'mid' | 'high'. Scales
# every retrieval strategy Hindsight runs (semantic, keyword, graph,
# temporal). Optional; defaults to Hindsight's own default ('mid').
HINDSIGHT_RECALL_BUDGET=mid

# Cap on every Hindsight call this service makes (recall, mental models,
# knowledge pages). A per-bank safety cap, not a latency target: a call returns
# as soon as it is done; this only stops a hung one. Optional; defaults to
# 4000 ms. Raise it (e.g. 8000) for headroom so a slow bank is not dropped on a
# spiky turn.
HINDSIGHT_TIMEOUT_MS=

# Cognition (services/cognition) — the derived-knowledge store Gaia owns:
# hypotheses, patterns and candidate models with their lifecycle. The Logos
# sync job mirrors it into Hindsight's `gaia-logos` bank under the single
# gaia:* namespace. On the VPS Cognition is Tailscale-bound and
# unauthenticated, like Hindsight.
#
# Reach it by CONTAINER NAME: gaia-api joins the cognition stack's external
# network (docker-compose.yml's cognition_net → gaia-cognition_default), so
# the container name resolves on the shared network exactly like http://hermes.
# Only fall back to the Tailscale address if you deliberately do not join it.
COGNITION_URL=http://gaia-cognition:8890
COGNITION_BANK_ID=gaia

# Foundation (github.com/Bojanni050/Foundation) — Bo's epistemische geheugen:
# raw observations, the ingestion gateway and MCP. Gaia reads it for
# archive-shaped asks (GET /api/memory/search, results status-labelled so a
# hypothesis never reads as a fact) and carries completed turns back in
# (POST /api/ingest/chat, source 'gaia'). Optional; unset = Gaia simply has no
# Foundation seam (no read, no submit — turns are not shipped anywhere but
# Hindsight). On the VPS Foundation binds the Tailscale address only:
# http://100.65.0.15:4577 (same posture as Hindsight above). Write routes need
# FOUNDATION_API_TOKEN; read routes are open today and send it only when set.
FOUNDATION_URL=
FOUNDATION_API_TOKEN=
# Default result count per search (1-10). Optional; defaults to 6.
FOUNDATION_MEMORY_LIMIT=

# File library (src/library.js) — where uploaded files are stored on
# disk. Optional; defaults to ./data/library in dev, /app/data/library in
# a container (same data/ volume already used by the provider store —
# see docker-compose.yml).
LIBRARY_PATH=
LIBRARY_MAX_FILE_SIZE_MB=25

# Chat history (src/conversationStore.js) — where saved conversation
# transcripts are stored on disk. Distinct from Hindsight (this is the
# raw log, never reflective memory) and from the library (this is never
# uploaded directly, only written as a side effect of a turn). Optional;
# defaults to ./data/history in dev, /app/data/history in a container
# (same data/ volume as the other stores above).
HISTORY_PATH=

# IntentIQ/ReasonIQ decision log (src/logos/decisionStore.js) — durable
# JSONL copy of the intentiq.decision/logos.result lines already
# console.log'd (intentLog.js/logosLog.js), so they survive past Docker's
# own log retention. Browsable via GET /admin/api/logos/decisions. One file
# per UTC day. Optional; defaults to ./data/logos-decisions in dev,
# /app/data/logos-decisions in a container.
LOGOS_DECISIONS_PATH=

# Logos background reflection model — fallback env vars for the unified
# provider's `reasoning` role (src/logos/logosModelClient.js,
# src/providerConfigResolver.js). Prefer the admin surface
# (PUT /admin/api/provider/roles { role: "reasoning", ... }); these apply
# only when no provider-store config exists. Leave unset in dev/eval —
# Logos degrades to shallow-only reflection rather than failing the turn
# (see eval/README.md for how the evaluation harness runs without this set).
REASONIQ_MODEL_PROVIDER=openai-compatible
REASONIQ_MODEL_BASE_URL=
REASONIQ_MODEL_NAME=
REASONIQ_MODEL_API_KEY=
# EdenAI alt: deepinfra/deepseek-ai/DeepSeek-V4-Flash (see top block)

# Kairos — the episode synthesizer (src/kairos/), Logos's younger sibling. It
# folds raw Foundation observations into narrative episodes and pushes them
# over the SSE stream. Prefer the admin surface
# (PUT /admin/api/provider/roles { role: "kairos", ... }); these apply only
# when no provider-store config exists. Leave unset and the worker simply
# does not start — reads/streams still serve whatever already exists.
KAIROS_MODEL_PROVIDER=openai-compatible
KAIROS_MODEL_BASE_URL=
KAIROS_MODEL_NAME=
KAIROS_MODEL_API_KEY=
# EdenAI alt: google/gemini-2.5-flash-lite | anthropic/claude-haiku-5-5 (see top block)

# Kairos worker. Off unless explicitly enabled. Interval is how often the
# worker polls the Foundation observation seam.
GAIA_KAIROS_ENABLED=false
GAIA_KAIROS_INTERVAL_MS=30000

# Hypothesis soft-promotion scan. Promotes stranded micro hypotheses the store
# holds in `testing` to `corroborated` (the machine tier) when they clear the
# confidence gate — records no turn touches again would otherwise never reach
# it. On by default; set to false to switch the scan off.
GAIA_HYPOTHESIS_SCAN=true
GAIA_HYPOTHESIS_SCAN_INTERVAL_MS=900000

# Hypothesis expiry — a hypothesis that never gathered evidence, and that
# nothing has touched for this many days, lapses: status `expired` with the
# reason `verlopen`. Deliberately NOT `rejected` (nothing happened, no
# judgement was made) and deliberately not terminal — evidence that arrives
# later revives it — and nothing is deleted, so a lapse stays checkable.
# Only hypotheses lapse; open questions and relationships have their own
# lives. Off with GAIA_HYPOTHESIS_EXPIRY=false.
GAIA_HYPOTHESIS_EXPIRY=true
GAIA_HYPOTHESIS_EXPIRY_DAYS=14

# How often the expiry pass looks for statements that have lapsed.
GAIA_HYPOTHESIS_EXPIRY_INTERVAL_MS=900000

# Open-question re-raise — the one place Gaia may bring one of her own
# unanswered questions up herself. Logos identifies open questions and has
# never asked them; this is the narrow exception: at most one per turn, in the
# conversation the question came from or in a new conversation about the same
# subject, never more than three times in total, and only once the retry term
# has passed since the last time. Raising changes nothing — the question stays
# open in the begrip panel until the person answers it. OFF by default, because
# this is the only place she speaks first.
GAIA_OPEN_QUESTION_REACH=

# How long a raised question stays quiet before she may bring it up again, and
# how often she may raise one at all (the hard maximum is three).
GAIA_OPEN_QUESTION_RETRY_DAYS=7
GAIA_OPEN_QUESTION_MAX=3

# Gaia primary generation (src/generation/gaiaGenerator.js) — Gaia's own
# voice, an OpenAI-compatible /chat/completions endpoint. v3.0 live path
# is direct generation through this provider first.
GAIA_NATIVE_BASE_URL=https://openrouter.ai/api/v1
GAIA_NATIVE_MODEL=google/gemini-2.5-flash
# EdenAI alt: anthropic/claude-haiku-5-5 | google/gemini-3.1-flash-lite (see top block)
GAIA_NATIVE_AUTH_TOKEN=
# Set to true if the primary model accepts images: attached pictures are then sent to it
# directly. If the model or provider rejects them, the turn is retried once with a description
# made by the 'vision' role model in /admin (falling back to 'reasoning'). Otherwise (default)
# pictures are always described first, and without such a model they cannot be read at all.
# PDFs and Word (.docx) files need neither: their text is extracted on the server.
GAIA_NATIVE_SUPPORTS_VISION=false

# Gaia backup generation (src/generation/generationFailover.js) — an
# independent OpenAI-compatible inference fallback. Used when no primary
# is configured, or when the primary fails before visible output with a
# timeout, network error, 429 or 5xx. Never on config errors or other 4xx.
# Leave unset to disable failover. Hermes is never a fallback.
GAIA_BACKUP_PROVIDER=
GAIA_BACKUP_BASE_URL=
GAIA_BACKUP_MODEL=
GAIA_BACKUP_AUTH_TOKEN=

# Gaia's voice (src/speech/mimoTts.js, src/speech/mistralTts.js) —
# presentation-only: reached exclusively from POST /speech, strictly after
# a text reply already exists. Never part of the Decision Engine, never a
# capability Gaia can choose — it has no say in what gets said, only how
# it sounds. Leave unset to disable /speech entirely (503).
#
# Two providers today, picked by which base URL/model you point at (or the
# admin panel's Voice section, which dispatches on the saved provider):
#   Xiaomi MiMo TTS, an OpenAI-compatible /chat/completions endpoint that
#     returns synthesized audio (Chinese/English pronunciation only).
#   Mistral Voxtral, POST {baseUrl}/audio/speech returning base64 JSON
#     (English, French, Spanish, Portuguese, Italian, Dutch, German,
#     Hindi, Arabic).
GAIA_TTS_BASE_URL=https://api.xiaomimimo.com/v1
GAIA_TTS_MODEL=mimo-v2.5-tts-voicedesign
GAIA_TTS_AUTH_TOKEN=
# Audio encoding both clients send (MiMo: wav/pcm16, default wav; Mistral:
# mp3/wav/pcm/flac/opus, default mp3). Unknown values fall back to the
# active client's own default rather than failing the call.
GAIA_TTS_FORMAT=wav
# Saved voice for providers with preset/custom voices — Mistral Voxtral's
# voice_id (a saved voice from GET /v1/audio/voices; empty for Mistral's
# default voice). Ignored by Xiaomi MiMo, which designs the voice from
# GAIA_TTS_VOICE_DESCRIPTION below instead.
GAIA_TTS_VOICE_ID=

# Optional override for Gaia's voice-design prompt (mimo-v2.5-tts-
# voicedesign synthesizes a voice from a textual description rather than a
# preset/sample). Leave unset to use the built-in default (calm, warm,
# unhurried, quietly confident — see mimoTts.js's DEFAULT_VOICE_DESCRIPTION).
GAIA_TTS_VOICE_DESCRIPTION=

# Gaia's listening (src/speech/mistralStt.js) — speech-to-text, reached
# exclusively from POST /speech/transcribe. An INPUT transport only: it turns
# one utterance of audio into text and hands the text back; the client then
# sends it as an ordinary turn. It never answers, never stores audio or
# transcripts (the admin log records bytes/timing/outcome only), and has no
# say in anything Gaia thinks. Leave unset to disable it (503).
# Any provider speaking POST {baseUrl}/audio/transcriptions (multipart:
# model, file, language?) works — Mistral Voxtral and OpenAI-compatible
# endpoints. The admin API (PUT /admin/api/stt/config) overrides these.
GAIA_STT_BASE_URL=
GAIA_STT_MODEL=
GAIA_STT_AUTH_TOKEN=

# IntentIQ's semantic classifier (src/logos/intentIQ.js's classifySemantic,
# src/logos/intentModelClient.js) — offline/eval-only: v3.0 runs no live
# IntentIQ pre-flight (Logos reflects after delivery), so no turn reads
# these. Kept for the evaluation harness (see eval/README.md). Not Hermes,
# not Logos's own reasoning model. Leave unset to run heuristic-only.
GAIA_INTENT_BASE_URL=
GAIA_INTENT_MODEL=
GAIA_INTENT_AUTH_TOKEN=

# Provider Settings (src/providerStore.js) — unified model provider
# configuration. One provider, four role-based model selections
# (Generation, Reasoning, Vision, TTS). Runtime-configurable via the
# admin surface (GET/PUT /admin/api/provider/*). Persisted as a single
# JSON file alongside reasoningModelStore.js's config.
GAIA_PROVIDER_CONFIG_PATH=

# Desktop (src/desktopBroker.js, docs/desktop-capability.md) — Gaia reaching for
# the person's OWN computer via Gaia-Desktop (Desktop Commander runs locally; the
# server executes nothing). Off by default. Even when on, a turn offers it only
# when the client sends `desktop: true` on a streamed turn. Reads run freely;
# writes and commands wait for the person's confirmation.
GAIA_DESKTOP=
# How long the person has to answer a prompt / an approved action to report back.
GAIA_DESKTOP_CONFIRM_TIMEOUT_MS=
GAIA_DESKTOP_RESULT_TIMEOUT_MS=
