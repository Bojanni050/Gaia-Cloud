# Copy to .env (gitignored) and fill in. Never commit real values.

# Required. Comma-separated bearer tokens clients may use (one per
# client/device is the intended pattern). No token configured = the API
# refuses every request (fail closed).
GAIA_API_TOKEN=change-me

# Where hermes-agent's OpenAI-compatible API is reachable from this
# container. hermes-agent binds only to its own docker network; this
# container joins that network (see docker-compose.yml) and reaches it
# by name, exactly like gaia-hermes-proxy does.
HERMES_BASE_URL=http://hermes:8642/v1

# Model name hermes-agent expects. Provider detail — never returned to any
# client.
HERMES_MODEL=hermes-agent

# The token hermes-agent itself requires (injected here so clients never
# hold it — same pattern as gaia-hermes-proxy).
HERMES_AUTH_TOKEN=

# Where Hindsight is reachable, and which bank Gaia reads/writes. Optional;
# defaults to the Tailscale address and the shared 'bojan' bank — Bo's
# general-purpose bank, also used by other tools, chosen deliberately over
# a Gaia-only bank so recall and the mental models (memory.js) can draw on
# everything already known about him, not just what Gaia itself has logged.
HINDSIGHT_URL=
HINDSIGHT_BANK_ID=bojan

# Recall budget for hindsightClient.js — 'low' | 'mid' | 'high'. Scales
# every retrieval strategy Hindsight runs (semantic, keyword, graph,
# temporal). Optional; defaults to Hindsight's own default ('mid').
HINDSIGHT_RECALL_BUDGET=mid

# File library (src/library.js) — where uploaded files are stored on
# disk. Optional; defaults to ./data/library in dev, /app/data/library in
# a container (same data/ volume already used by reasoningModelStore.js —
# see docker-compose.yml).
LIBRARY_PATH=
LIBRARY_MAX_FILE_SIZE_MB=25

# Chat history (src/conversationStore.js) — where saved conversation
# transcripts are stored on disk. Distinct from Hindsight (this is the
# raw log, never reflective memory) and from the library (this is never
# uploaded directly, only written as a side effect of a turn). Optional;
# defaults to ./data/history in dev, /app/data/history in a container
# (same data/ volume as the other stores above).
HISTORY_PATH=

# IntentIQ/ReasonIQ decision log (src/logos/decisionStore.js) — durable
# JSONL copy of the intentiq.decision/reasoniq.result lines already
# console.log'd (intentLog.js/reasonLog.js), so they survive past Docker's
# own log retention. Browsable via GET /admin/api/logos/decisions. One file
# per UTC day. Optional; defaults to ./data/logos-decisions in dev,
# /app/data/logos-decisions in a container.
LOGOS_DECISIONS_PATH=

# ReasonIQ's own reasoning model (src/logos/reasoningModelClient.js) — a
# separate seam from Hermes above. Independently configurable; not a Gaia
# capability, never selected by Gaia. Leave unset in dev/eval — ReasonIQ
# degrades to shallow-only reasoning rather than failing the turn (see
# eval/README.md for how the evaluation harness runs without this set).
REASONIQ_MODEL_PROVIDER=openai-compatible
REASONIQ_MODEL_BASE_URL=
REASONIQ_MODEL_NAME=
REASONIQ_MODEL_API_KEY=

# Gaia Native Generator (src/generation/gaiaGenerator.js) — Gaia's own
# voice for conversational turns, independent of Hermes. Uses the same
# OpenAI-compatible /chat/completions shape. When configured, the Decision
# Engine routes simple/conversational turns here instead of through Hermes.
# Leave unset to route everything through Hermes (the existing behavior).
GAIA_NATIVE_BASE_URL=https://openrouter.ai/api/v1
GAIA_NATIVE_MODEL=google/gemini-2.5-flash
GAIA_NATIVE_AUTH_TOKEN=

# Gaia's voice (src/speech/mimoTts.js) — Xiaomi MiMo TTS, an OpenAI-
# compatible /chat/completions endpoint that returns synthesized audio.
# Presentation-only: reached exclusively from POST /speech, strictly after
# a text reply already exists. Never part of the Decision Engine, never a
# capability Gaia can choose — it has no say in what gets said, only how
# it sounds. Leave unset to disable /speech entirely (503).
GAIA_TTS_BASE_URL=https://api.xiaomimimo.com/v1
GAIA_TTS_MODEL=mimo-v2.5-tts-voicedesign
GAIA_TTS_AUTH_TOKEN=
GAIA_TTS_FORMAT=wav

# Optional override for Gaia's voice-design prompt (mimo-v2.5-tts-
# voicedesign synthesizes a voice from a textual description rather than a
# preset/sample). Leave unset to use the built-in default (calm, warm,
# unhurried, quietly confident — see mimoTts.js's DEFAULT_VOICE_DESCRIPTION).
GAIA_TTS_VOICE_DESCRIPTION=

# Gaia's web tool (src/tools/braveSearch.js) — Brave Search API, for
# current external information the Decision Engine judges Gaia does not
# already have (sourceOfTruth "external_knowledge"). A specialist
# capability like Hermes/the native generator: it never decides whether
# Gaia needs it, it only performs the search once asked, and it answers
# directly (a formatted summary of the top results) rather than handing
# results to another capability to synthesize. Leave GAIA_WEB_SEARCH_API_KEY
# unset to disable the web tool entirely — external-knowledge turns then
# route through Hermes exactly as before this existed.
GAIA_WEB_SEARCH_API_KEY=
GAIA_WEB_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
GAIA_WEB_SEARCH_RESULT_COUNT=5
